# PrepMate Environment Configuration Example
# Copy this file to .env and fill in your actual values.
# NEVER commit the actual .env file to Git!

# Django Security
SECRET_KEY=django-insecure-replace-this-with-a-random-secret-key-for-production
DEBUG=True

# Allowed Hosts & CSRF Origins (comma-separated)
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost

# Database Configuration (leave empty to use local SQLite, or provide PostgreSQL URL)
# Example: postgresql://username:password@hostname:5432/database_name
DATABASE_URL=

# Google Gemini API Key for AI features (mock interview, test generation, notes)
GEMINI_API_KEY=your_gemini_api_key_here

# Daily AI Request Limit per user (prevents quota exhaustion)
DAILY_AI_LIMIT=20
